{
  "version": 2,

  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/index.html",
      "use": "@vercel/static"
    }
  ],

  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/main.py"
    },
    {
      "src": "/favicon.ico",
      "dest": "/backend/main.py"
    },
    {
      "src": "/favicon.png",
      "dest": "/backend/main.py"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    }
  ]
}
